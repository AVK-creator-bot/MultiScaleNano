# Copy to .env and adjust if needed (optional for local dev)

# Where simulation artifacts are stored
MULTISCALE_ARTIFACT_DIR=./data/artifacts

# API (used by workers; web defaults to http://localhost:8000)
MULTISCALE_API_URL=http://localhost:8000

# Redis (optional — API runs simulations in-process without Redis)
MULTISCALE_REDIS_URL=redis://localhost:6379/0

# Web app — leave empty to use Next.js proxy, or set explicitly:
# NEXT_PUBLIC_API_URL=http://localhost:8000
