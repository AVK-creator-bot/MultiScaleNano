FROM python:3.12-slim-bookworm

WORKDIR /app

# OpenMM runtime deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY packages/core /app/packages/core
COPY workers/simulation /app/workers/simulation
COPY apps/api /app/apps/api

RUN pip install --no-cache-dir -U pip \
    && pip install --no-cache-dir openmm \
    && pip install --no-cache-dir -e /app/packages/core -e /app/workers/simulation -e /app/apps/api

RUN mkdir -p /data/artifacts /data/store

ENV MULTISCALE_ARTIFACT_DIR=/data/artifacts
ENV MULTISCALE_API_URL=http://127.0.0.1:8000
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --app-dir /app/apps/api"]
